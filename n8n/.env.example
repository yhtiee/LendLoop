# Self-hosted n8n (docker compose). Copy to n8n/.env, never commit n8n/.env.

# Postgres password for n8n's own database
POSTGRES_PASSWORD=change-me
# Encrypts n8n credentials at rest: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# LendLoop integration. Must match the Convex env vars:
#   LENDLOOP_WEBHOOK_SECRET  = npx convex env get N8N_WEBHOOK_SECRET
#   LENDLOOP_CALLBACK_SECRET = npx convex env get N8N_CALLBACK_SECRET
LENDLOOP_WEBHOOK_SECRET=
LENDLOOP_CALLBACK_SECRET=
# Your Convex HTTP actions URL (ends in .convex.site)
LENDLOOP_CONVEX_SITE_URL=
LENDLOOP_FROM_EMAIL=LendLoop <no-reply@lendloop.app>
