# Next.js app. Copy to .env.local and fill in. Never commit .env.local.

# Clerk: https://dashboard.clerk.com -> your app -> API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex: written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# ---------------------------------------------------------------------------
# Convex deployment env vars are NOT read from this file. Set them with
# `npx convex env set NAME value`:
#
#   CLERK_JWT_ISSUER_DOMAIN  Clerk Frontend API URL (Clerk > Integrations > Convex)
#   N8N_WEBHOOK_SECRET       HMAC key, Convex -> n8n     (openssl rand -hex 32)
#   N8N_CALLBACK_SECRET      HMAC key, n8n -> Convex     (openssl rand -hex 32)
#   N8N_WEBHOOK_URL          Production URL of the "LendLoop webhook" node in n8n
#   APP_URL                  Base URL used in email links (e.g. http://localhost:3000)
